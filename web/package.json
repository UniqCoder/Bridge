{
  "name": "bridgewitness-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "fixtures": "node scripts/build-fixtures.mjs",
    "data": "node -e \"const fs=require('fs');fs.mkdirSync('public/data',{recursive:true});for(const f of ['nomad','ronin','simulated'])fs.copyFileSync('../bridgewitness/artifacts/replay_'+f+'.json','public/data/replay_'+f+'.json');fs.copyFileSync('../bridgewitness/artifacts/metrics.json','public/data/metrics.json')\"",
    "check": "node scripts/check-demo.mjs"
  },
  "dependencies": {
    "@ethereumjs/rlp": "5.0.2",
    "@noble/hashes": "1.5.0",
    "@react-three/drei": "9.122.0",
    "@react-three/fiber": "8.18.0",
    "@react-three/postprocessing": "2.19.1",
    "framer-motion": "11.11.17",
    "graphology": "0.25.4",
    "graphology-layout-forceatlas2": "0.10.1",
    "graphology-types": "0.24.8",
    "lenis": "1.1.20",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-router-dom": "6.28.0",
    "sigma": "3.0.2",
    "three": "0.170.0",
    "uplot": "1.6.31"
  },
  "devDependencies": {
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "@types/three": "0.170.0",
    "@vitejs/plugin-react": "4.3.4",
